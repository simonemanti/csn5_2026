    },
    "legacy_stage_rule": "Legacy simulation stages S1-S5 support grant WP1 activities A1.1-A1.4; they are not grant Work Packages.",
    "resolution_rule": "incident_energy_resolution and czt_energy_resolution are distinct observables."
  },
