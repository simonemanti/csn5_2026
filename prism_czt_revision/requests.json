Id": "prism_ref_357", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "prism_ref_357", "insertionIndex": 0, "text": "Manti et al., Condens. Matter 11, 38 (2026).\nPrevious CZT measurements. PRISM targets remain to be validated."}}, {"deleteParagraphBullets": {"objectId": "prism_ref_357", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "prism_ref_357", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 9.5, "unit": "PT"}}, "fields": "fontSize"}}, {"updateParagraphStyle": {"objectId": "prism_ref_357", "textRange": {"type": "ALL"}, "style": {"indentStart": {"magnitude": 0, "unit": "PT"}, "indentEnd": {"magnitude": 0, "unit": "PT"}, "indentFirstLine": {"magnitude": 0, "unit": "PT"}, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 0, "unit": "PT"}, "lineSpacing": 110}, "fields": "indentStart,indentEnd,indentFirstLine,spaceAbove,spaceBelow,lineSpacing"}}, {"updatePageElementTransform": {"objectId": "prism_ref_357", "applyMode": "ABSOLUTE", "transform": {"scaleX": 1.3504333333333334, "scaleY": 0.11006666666666666, "translateX": 42, "translateY": 336, "unit": "PT"}}}, {"deleteText": {"objectId": "prism_czt_targets", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "prism_czt_targets", "insertionIndex": 0, "text": "Qualification targets at M15\n\nIntrinsic efficiency >90% at 50 keV\n\nResolution \u22642% at Ag K\u03b1 (22.2 keV)\n\nDead time <10%\nPile-up contamination <5%\n\nUnder XAS operating conditions"}}, {"deleteParagraphBullets": {"objectId": "prism_czt_targets", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "prism_czt_targets", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14.5, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "prism_czt_targets", "textRange": {"type": "ALL"}, "style": {"indentStart": {"magnitude": 0, "unit": "PT"}, "indentEnd": {"magnitude": 0, "unit": "PT"}, "indentFirstLine": {"magnitude": 0, "unit": "PT"}, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 0, "unit": "PT"}, "lineSpacing": 110}, "fields": "indentStart,indentEnd,indentFirstLine,spaceAbove,spaceBelow,lineSpacing"}}, {"updatePageElementTransform": {"objectId": "prism_czt_targets", "applyMode": "ABSOLUTE", "transform": {"scaleX": 1.2615333333333334, "scaleY": 0.7789333333333334, "translateX": 380, "translateY": 110, "unit": "PT"}}}, {"updateTextStyle": {"objectId": "prism_czt_targets", "textRange": {"type": "FIXED_RANGE", "startIndex": 0, "endIndex": 27}, "style": {"bold": true, "foregroundColor": {"opaqueColor": {"rgbColor": {"red": 0.24, "green": 0.61, "blue": 0.72}}}}, "fields": "bold,foregroundColor"}}, {"deleteObject": {"objectId": "h4dc4f3af379f64a9_0_56"}}, {"createShape": {"objectId": "prism_czt_development_v3", "shapeType": "TEXT_BOX", "elementProperties": {"pageObjectId": "h14ac1f20202dfc06_1_13", "size": {"width": {"magnitude": 298, "unit": "PT"}, "height": {"magnitude": 59, "unit": "PT"}}, "transform": {"scaleX": 1, "scaleY": 1, "translateX": 380, "translateY": 301, "unit": "PT"}}}}, {"insertText": {"objectId": "prism_czt_development_v3", "text": "PRISM development\nPixel calibration and charge-sharing reconstruction\nWaveform DAQ: 64 ch, 16 bit, 125 MS/s", "insertionIndex": 0}}, {"updateTextStyle": {"objectId": "prism_czt_development_v3", "textRange": {"type": "ALL"}, "style": {"fontFamily": "Helvetica Neue", "fontSize": {"magnitude": 12.5, "unit": "PT"}, "bold": false, "foregroundColor": {"opaqueColor": {"rgbColor": {"red": 0, "green": 0.16470589, "blue": 0.28235295}}}}, "fields": "fontFamily,fontSize,bold,foregroundColor"}}, {"updateParagraphStyle": {"objectId": "prism_czt_development_v3", "textRange": {"type": "ALL"}, "style": {"spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 0, "unit": "PT"}, "lineSpacing": 105}, "fields": "spaceAbove,spaceBelow,lineSpacing"}}, {"deleteText": {"objectId": "h44cae004078c7866_0_34", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "h44cae004078c7866_0_34", "text": "PRISM baseline: monolithic 2-mm-thick CZT crystal, 20-pixel linear array, 500 \u00b5m pitch, common cathode and guard ring. The sensor image is illustrative, not the final PRISM layout. The calculated efficiency comparison uses 1-mm CZT, not the 2-mm project baseline. Energy-resolved fluorescence detection helps reject background. Source: FINAL/Progetto.pdf, pp. 4\u20135. Fabrication and qualification are project activities.", "insertionIndex": 0}}, {"deleteText": {"objectId": "h14ac1f20202dfc06_1_19", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "h14ac1f20202dfc06_1_19", "text": "The pulse-selection figure shows prior CZT measurements at DA\u03a6NE BTF, as identified by Figure 3 of the submitted proposal and the local 13_CZT/v3_CZT.png caption. It does not demonstrate the future PRISM multichannel detector performance. PRISM will develop dedicated low-noise front-end electronics, waveform acquisition, pixel calibration, gain equalization, charge-sharing reconstruction and pile-up rejection. M15 targets: intrinsic efficiency >90% at 50 keV, energy resolution \u22642% at Ag K\u03b1 22.2 keV, dead time <10% and pile-up contamination <5% under XAS operating conditions. The detector energy resolution selects fluorescence and must be distinguished from the \u226410 eV incident-beam bandwidth. Source: FINAL/Progetto.pdf, ER2, WP2 and MS2.", "insertionIndex": 0}}]